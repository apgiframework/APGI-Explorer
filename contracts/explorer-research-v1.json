            "title": "Refresh Expires In"
          },
          "refresh_token": {
            "description": "New JWT refresh token (rotated; old token is revoked)",
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "description": "Token type",
            "title": "Token Type",
            "type": "string"
