    "/v1/participant-sessions/{participant_session_id}/events": {
      "post": {
        "description": "Each event is acknowledged exactly once with server_verified=true after the server has re-hashed the canonical payload and persisted it. Re-sending an event with the same event_id, seq_no and hash is acknowledged as a duplicate; reusing an event_id or seq_no with different content is a 409.",
        "operationId": "upload_journal_events_v1_participant_sessions__participant_session_id__events_post",
        "parameters": [
          {
            "in": "path",
            "name": "participant_session_id",
            "required": true,
            "schema": {
              "title": "Participant Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalEventBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAckBatch"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Idempotent journal upload",
        "tags": [
          "Explorer"
        ]
      }
    },
    "/v1/participant-sessions/{participant_session_id}/explorer-result": {
      "get": {
        "operationId": "get_explorer_result_v1_participant_sessions__participant_session_id__explorer_result_get",
        "parameters": [
          {
            "in": "path",
            "name": "participant_session_id",
            "required": true,
            "schema": {
              "title": "Participant Session Id",
              "type": "string"
