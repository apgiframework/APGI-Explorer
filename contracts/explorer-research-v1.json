  "info": {
    "title": "Explorer research contract (extract of apgi-api, not yet deployed)",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/refresh": {
      "post": {
        "description": "Use a refresh token to obtain a new access token.\n\n    This endpoint should be called when the access token expires to get a new one\n    without requiring the user to log in again.",
        "operationId": "refresh_token_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "expires_in": 1800,
                  "token_type": "bearer"
                },
                "schema": {
                  "$ref": "#/components/schemas/TokenRefreshResponse"
                }
              }
            },
            "description": "Token refreshed successfully"
          },
          "401": {
            "description": "Invalid or expired refresh token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh access token",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/v1/consent-texts": {
      "get": {
        "operationId": "list_consent_texts_v1_consent_texts_get",
        "parameters": [
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "default": "en",
              "maxLength": 10,
              "minLength": 2,
              "title": "Locale",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConsentTextResponse"
                  },
                  "title": "Response List Consent Texts V1 Consent Texts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Consent Texts",
        "tags": [
          "Explorer"
        ]
      }
    },
    "/v1/explorer/config": {
      "get": {
