      "TokenRefreshRequest": {
        "description": "Request to refresh access token.",
        "example": {
          "refresh_token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
        },
        "properties": {
          "refresh_token": {
            "description": "Valid refresh token",
